<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Newer Android versions gate DevicePolicyManager.lockNow() behind this explicit
         permission even for Device Owner apps (part of Android's granular device-policy
         permission model) — without it, real hardware on an affected OS build rejects every
         LOCK with "No active admin ... doesn't have [android.permission.LOCK_DEVICE]", observed
         on real enrolled devices (DEV-2026-000314, DEV-2026-000320). Device Owner apps get this
         auto-granted on declaration, same as the other permissions below — no runtime prompt. -->
    <uses-permission android:name="android.permission.LOCK_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- For the payment-reminder push notification (FcmService.showReminderNotification) and
         HeartbeatForegroundService's required (minimized) foreground-service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- HeartbeatForegroundService: a persistent foreground service (not a one-shot WorkManager
         promotion) that keeps command delivery working under aggressive OEM battery managers.
         systemExempted is the type Android reserves for Device Owner/Admin apps specifically —
         no execution time limit, unlike dataSync's 6h/24h cap. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Location tracking + SIM/phone-number telemetry, both self-granted via
         setPermissionGrantState() since this app is Device Owner — no runtime prompt shown
         to the customer. See DeviceRestrictionPolicy.grantLocationAndPhonePermissions(). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- WifiBlockManager/WifiStateEnforcer: CHANGE_WIFI_STATE is normal (not runtime-dangerous),
         but setWifiEnabled() only actually takes effect for a Device Owner app on API 29+ — see
         CommandDispatcher's explicit isDeviceOwnerApp() check. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- BluetoothBlockManager: BLUETOOTH_CONNECT (API 31+) is a runtime-dangerous permission that
         gates BluetoothAdapter.disable()/enable() for everyone except a Device Owner app, which
         self-grants it via setPermissionGrantState() — see
         DeviceRestrictionPolicy.grantBluetoothPermission(). Below API 31, the same calls only
         needed the normal (non-dangerous) BLUETOOTH_ADMIN/BLUETOOTH permissions, so those are
         declared maxSdkVersion-capped rather than also self-granted. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- WallpaperOverlayManager: SET_WALLPAPER/SET_WALLPAPER_HINTS are normal (not
         runtime-dangerous) permissions, auto-granted on declaration like everything else here.
         SYSTEM_ALERT_WINDOW ("draw over other apps") is different — it's a special permission,
         not a standard runtime one, so declaring it here is necessary but not sufficient; see
         WallpaperOverlayService's doc comment for the self-grant attempt and its caveat. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- AlarmPlaybackService: turns the screen on so the buzzer is impossible to miss, same as
         a real alarm clock app. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package-visibility declaration (API 30+) for KioskLockActivity's "Call Dealer" button,
         which opens the dialer via an implicit ACTION_DIAL Intent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NexLock"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="NexLock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".provisioning.ProvisioningCompleteActivity"
            android:exported="false"
            android:label="NexLock" />

        <activity
            android:name=".provisioning.TermsAcceptanceActivity"
            android:exported="false"
            android:label="NexLock" />

        <activity
            android:name=".kiosk.KioskLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:label="NexLock" />

        <service
            android:name=".service.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".service.HeartbeatForegroundService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <service
            android:name=".service.WallpaperOverlayService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <service
            android:name=".service.AlarmPlaybackService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Fires after AgentSelfUpdater silently installs a new version over the running
                     one — same reassertion BootReceiver already does on a real reboot (baseline
                     restrictions, Wi-Fi/Bluetooth block enforcement, kiosk lock state, heartbeat
                     scheduling) applies equally well right after a package replacement. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.AgentSelfUpdater$InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nexlock.agent.SELF_UPDATE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.NexLockDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
