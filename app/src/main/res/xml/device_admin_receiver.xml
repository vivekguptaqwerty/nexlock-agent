<?xml version="1.0" encoding="utf-8"?>
<!--
  Policy flags requested by NexLockDeviceAdminReceiver. force-lock and wipe-data are the
  base policies Android requires for a Device Admin to call lockNow()/wipeData(). The
  disable-keyguard-features and limit-password policies are declared so those APIs are
  available to a future policy change without a re-provisioning round trip, even though
  Phase 3 does not enforce a password quality requirement (kiosk pinning, not the OS
  keyguard, is the real enforcement mechanism here).
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
        <disable-keyguard-features />
        <limit-password />
    </uses-policies>
</device-admin>
