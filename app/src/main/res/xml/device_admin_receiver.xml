<?xml version="1.0" encoding="utf-8"?>
<!--
  Policy flags requested by NexLockDeviceAdminReceiver. force-lock and wipe-data are the
  base policies Android requires for a Device Admin to call lockNow()/wipeData(). The
  disable-keyguard-features and limit-password policies are declared so those APIs are
  available to a future policy change without a re-provisioning round trip, even though
  Phase 3 does not enforce a password quality requirement (kiosk pinning, not the OS
  keyguard, is the real enforcement mechanism here).
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
        <disable-keyguard-features />
        <limit-password />
    </uses-policies>
    <!--
      Required for the Redmi/Poco bootstrap flow: Google's TestDPC becomes Device Owner via QR,
      then transfers ownership to this receiver. DevicePolicyManager.transferOwnership() rejects
      any target whose admin metadata doesn't declare this (DeviceAdminInfo.supportsTransferOwnership()
      must be true), failing with a Preconditions.checkArgument RemoteException. Harmless on every
      other brand — it only enables being a transfer target, nothing is transferred unless a
      current owner explicitly initiates it.
    -->
    <support-transfer-ownership />
</device-admin>
